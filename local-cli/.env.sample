# Copy to the CLIENT REPO ROOT as `.env` (the scripts resolve it two levels
# above scripts/data/). Do not commit the filled-in copy.

# sql.sh — paste the full connection string from the Fabric portal; only
# Server= and Initial Catalog= are parsed. If the repo already uses another
# var name, rename CONN_VAR in sql.sh instead.
SQL_CONNECTION_STRING=Server=tcp:<server>.database.fabric.microsoft.com,1433;Initial Catalog=<database>;Encrypt=True;

# kql.sh — Query URI from the KQL database detail page; name or item GUID.
KUSTO_CLUSTER_URI=https://<cluster>.<region>.kusto.fabric.microsoft.com
KUSTO_DATABASE=<KqlDatabaseName>

# lake.sh reads nothing from .env — connection details go inline in the ABFSS URL.
